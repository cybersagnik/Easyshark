# EasyShark v2.0.0 — Environment Configuration
#
# 1. Copy this file to .env:    cp .env.example .env
# 2. Set at least ZEN_API_KEY (or OpenRouter/Groq as fallback).
# 3. Run:                       python3 main.py PCAP_SAMPLES/evidence01.pcap
#
# Cloud-only: Zen (primary) -> OpenRouter (secondary) -> Groq (last resort).
# No local model. No GPU required.

# === REQUIRED: LLM Provider ===
# At least one API key is needed for AI-powered commands (analyze, investigate,
# report). Deterministic commands (protocols, creds, summary, extract-media)
# work fully offline.
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_ENABLED=1
# ZEN_ENABLED=0 disables Zen. Deterministic commands still work.

# Per-role Zen models (cost-optimised defaults).
# Override via env: ZEN_EXPLAINER_MODEL=deepseek-v4-flash
ZEN_EXPLAINER_MODEL=deepseek-v4-flash
ZEN_PLANNER_MODEL=gpt-5-nano
ZEN_CODER_MODEL=gpt-5.4-nano
ZEN_CRITIC_MODEL=gpt-5-nano

# === OPTIONAL: Fallback Providers ===
OPENROUTER_ENABLED=1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-role OpenRouter free models (fallback when Zen is rate-limited).
# Set OPENROUTER_API_KEY to enable.
OPENROUTER_EXPLAINER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_PLANNER_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_CODER_MODEL=cohere/north-mini-code:free
OPENROUTER_CRITIC_MODEL=openai/gpt-oss-20b:free

GROQ_ENABLED=1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# === RECOMMENDED: Sandbox + python_eval ===
# Advertise the python_eval and create_tool tools to the LLM.
# Without this, the LLM cannot run custom Python over packets.
EASYSHARK_ALLOW_PYTHON_EVAL=1
# Route python_eval through a subprocess/container (1) or in-process (0).
EASYSHARK_PROCESS_SANDBOX=1
# Sandbox backend: local (in-process), opensandbox (Docker), auto (try both).
# auto tries the container first; falls back to in-process when the server is down.
EASYSHARK_SANDBOX_BACKEND=auto

# === OPTIONAL: OpenSandbox Container (Docker required) ===
# Start the server: OPENSANDBOX_INSECURE_SERVER=YES nohup opensandbox-server \
#   --config ~/.sandbox.toml &
# Install: pip install opensandbox-server
# Config:  opensandbox-server init-config ~/.sandbox.toml --example docker
# OPEN_SANDBOX_DOMAIN=http://127.0.0.1:8080
# OPEN_SANDBOX_PROTOCOL=http
# OPEN_SANDBOX_API_KEY=
# EASYSHARK_SANDBOX_IMAGE=python:3.12-slim

# === OPTIONAL: CYSOC + Threat Intel ===
# EASYSHARK_SOC_DB=~/.easyshark/cysoc.db
# EASYSHARK_ORACLE_DB=~/.easyshark/oracle.db
# EASYSHARK_ASSET_POLICY=config/assets.example.json
# EASYSHARK_CONNECTOR_HOSTS=sentinel.example.com

# === OPTIONAL: Monitoring + Webhooks ===
# EASYSHARK_HEALTH_TOKEN=
# EASYSHARK_THREAT_FEED=
# EASYSHARK_WEBHOOK_URL=
# EASYSHARK_WEBHOOK_TOKEN=
# EASYSHARK_EVENT_WEBHOOK=

# === RSI Pattern Learning ===
# Learned tool patterns require independent oracle feedback before activation.
EASYSHARK_RSI_ENABLED=1
EASYSHARK_RSI_REQUIRE_FEEDBACK=1
