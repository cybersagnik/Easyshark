# Phase 14 — provider chain: Zen (primary) -> OpenRouter (secondary) ->
# Groq (last resort). Ollama is REMOVED from the active routing chain.

# OpenCode Zen (PRIMARY). OpenAI-compatible endpoint, free models.
ZEN_ENABLED=1
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1

# Per-role model overrides for Zen (optional).
# ZEN_EXPLAINER_MODEL=deepseek-v4-flash-free
# ZEN_PLANNER_MODEL=ling-3.0-flash-free
# ZEN_CODER_MODEL=north-mini-code-free
# ZEN_CRITIC_MODEL=deepseek-v4-flash-free

# OpenRouter (SECONDARY — used when Zen is degraded/rate-limited).
# 50 requests/day hard account cap.
OPENROUTER_ENABLED=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-role OpenRouter free models (optional overrides).
# OPENROUTER_EXPLAINER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_PLANNER_MODEL=nvidia/nemotron-nano-9b-v2:free
# OPENROUTER_CODER_MODEL=cohere/north-mini-code:free
# OPENROUTER_CRITIC_MODEL=openai/gpt-oss-20b:free

# Groq (LAST RESORT — only when Zen AND OpenRouter both fail).
# GROQ_MODEL is a single model applied to ALL roles; per-role
# GROQ_*_MODEL vars override it when set.
GROQ_ENABLED=0
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_EXPLAINER_MODEL=llama-3.1-8b-instant
# GROQ_PLANNER_MODEL=llama-3.1-8b-instant
# GROQ_CODER_MODEL=llama-3.1-8b-instant
# GROQ_CRITIC_MODEL=llama-3.3-70b-versatile

# RSI safety gate. Learned tool patterns require independent oracle feedback
# before they can influence future planning. Set to 0 only for legacy behavior.
EASYSHARK_RSI_ENABLED=1
EASYSHARK_RSI_REQUIRE_FEEDBACK=1
# Run generated analysis snippets in a separate clean interpreter.
EASYSHARK_PROCESS_SANDBOX=1
EASYSHARK_HEALTH_TOKEN=
EASYSHARK_THREAT_FEED=
EASYSHARK_EVENT_TOKEN=
EASYSHARK_WEBHOOK_URL=
EASYSHARK_EVENT_WEBHOOK=
EASYSHARK_WEBHOOK_TOKEN=
# Generated-code sandbox: local (default), auto, or opensandbox.
EASYSHARK_SANDBOX_BACKEND=local
# OPEN_SANDBOX_DOMAIN=localhost:8080
# OPEN_SANDBOX_PROTOCOL=http
# OPEN_SANDBOX_API_KEY=
# EASYSHARK_SANDBOX_IMAGE=python:3.12-slim
# EASYSHARK_SOC_DB=~/.easyshark/cysoc.db
# EASYSHARK_ORACLE_DB=~/.easyshark/oracle.db
# EASYSHARK_ASSET_POLICY=config/assets.example.json
# Comma-separated exact HTTPS hostnames approved for read-only SOC connectors.
# EASYSHARK_CONNECTOR_HOSTS=sentinel.example.com,splunk.example.com
